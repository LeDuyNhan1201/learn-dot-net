{
  "Server": {
    "Name": "Restaurant_Testing"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
    }
  },
  "Observability": {
    "UseTracingExporter": "console",
    "UseMetricsExporter": "console",
    "UseLoggingExporter": "console",
    "HistogramAggregation": "explicit"
  },
  "Keycloak": {
    "Realm": "learn-dot-net-test",
    "AuthServerUrl": "http://localhost:8080",
    "SslRequired": "none",
    "Resource": "restaurant-public",
    "Credentials": {
      "Secret": ""
    },
    "PublicClient": true,
    "ConfidentialPort": 0
  },
  "KeycloakAdmin": {
    "Realm": "learn-dot-net-test",
    "AuthServerUrl": "http://localhost:8080",
    "SslRequired": "none",
    "Resource": "restaurant-internal",
    "Credentials": {
      "Secret": "secret"
    },
    "ConfidentialPort": 0
  }
}
